<!doctype html><html lang="vi" class="scroll-smooth"><head><partial name="_DesignHead" /><link rel="stylesheet" href="~/admin/assets/css/admin.css" asp-append-version="true" /><script src="~/admin/assets/js/theme-init.js" asp-append-version="true"></script><link rel="stylesheet" href="~/css/studio.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/quiz-builder.css" asp-append-version="true" />@await RenderSectionAsync("Styles", required: false)</head>
<body class="admin-page font-sans antialiased min-h-screen flex selection:bg-blue-600 selection:text-white">
<a class="skip" href="#main">Đến nội dung chính</a><div id="sidebarBackdrop" data-ui-action="toggle-admin-sidebar" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-40 hidden lg:hidden"></div><partial name="_AdminSidebar" />
<div class="flex-1 flex flex-col min-w-0"><header class="admin-topbar sticky top-0 z-30 px-4 lg:px-8"><div class="flex items-center gap-3"><button type="button" data-ui-action="toggle-admin-sidebar" aria-label="Mở menu quản trị" class="admin-icon-button lg:hidden"><i data-lucide="menu"></i></button><div class="admin-breadcrumb">Admin <span>/</span> <strong>@ViewData["Title"]</strong></div></div><a href="/" class="admin-home-link"><i data-lucide="external-link"></i>Về trang chủ</a></header>
<main id="main" class="mvc-content admin-content @(ViewContext.RouteData.Values["controller"]?.ToString() is "Instructor" or "Curriculum" ? "studio" : "") p-4 sm:p-6 lg:p-8 max-w-7xl mx-auto w-full flex-1"><partial name="_Feedback" />@RenderBody()</main></div>
<script src="~/js/design.js" asp-append-version="true"></script><script src="~/js/ui-actions.js" asp-append-version="true"></script><script src="~/js/tooltip.js" asp-append-version="true"></script><script src="~/admin/assets/js/admin-actions.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)</body></html>