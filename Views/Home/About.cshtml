@model HomePageViewModel
@{
    ViewData["Title"] = "Về chúng tôi";
    ViewData["FullWidth"] = true;
}

<!-- Giới thiệu -->
<section class="catalog-hero">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 grid lg:grid-cols-2 gap-10 items-center">
        <div>
            <span class="inline-block px-4 py-1.5 rounded-full bg-white border border-blue-100 text-xs font-bold text-blue-700">VỀ CHÚNG TÔI</span>
            <h1 class="mt-4 text-4xl sm:text-5xl font-black leading-tight text-slate-900">Kết nối người <span class="text-blue-600">muốn học</span> với người <span class="home-accent">giỏi dạy</span></h1>
            <p class="mt-5 text-lg text-slate-600">
                EduFlow là nền tảng học trực tuyến đa lĩnh vực. Giảng viên đã được xác minh xây dựng khóa học theo chương bài,
                học viên học theo lộ trình, làm bài kiểm tra và theo dõi tiến độ của mình.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
                <a href="/Courses" class="btn-primary">Khám phá khóa học <i data-lucide="arrow-right" class="w-4 h-4"></i></a>
                <a href="/Home/Contact" class="btn-outline">Liên hệ với chúng tôi</a>
            </div>
        </div>
        <img src="~/images/illustration-desk.svg" alt="" class="hidden lg:block w-full max-w-lg ml-auto" />
    </div>
</section>

<!-- Số liệu thật -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-8 relative">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        @foreach (var stat in new[] { (Model.TotalCourses, "Khóa học", "book-open"), (Model.TotalLessons, "Bài học", "play-circle"),
                                      (Model.TotalInstructors, "Giảng viên", "presentation"), (Model.TotalStudents, "Học viên", "users") })
        {
            <div class="contact-card justify-center">
                <span class="contact-icon"><i data-lucide="@stat.Item3" class="w-5 h-5"></i></span>
                <div><strong class="block text-3xl font-black text-slate-900">@stat.Item1</strong><span class="text-sm text-slate-500">@stat.Item2</span></div>
            </div>
        }
    </div>
</section>

<!-- Sứ mệnh và giá trị -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center max-w-2xl mx-auto">
        <h2 class="text-3xl font-black text-slate-900">Sứ mệnh của EduFlow</h2>
        <p class="mt-3 text-slate-600">Giúp mọi người tiếp cận kiến thức chất lượng với chi phí hợp lý, ở bất kỳ đâu và vào bất kỳ lúc nào.</p>
    </div>
    <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        @foreach (var v in new[] {
            ("target", "Học có mục tiêu", "Mỗi khóa học nêu rõ bạn sẽ học được gì và cần kiến thức gì trước khi bắt đầu."),
            ("shield-check", "Chất lượng được kiểm duyệt", "Giảng viên gửi hồ sơ định danh, khóa học được quản trị viên duyệt trước khi xuất bản."),
            ("list-checks", "Học đi đôi với kiểm tra", "Bài quiz sau mỗi phần, phải đạt điểm mới mở được bài tiếp theo."),
            ("globe", "Nhiều lĩnh vực", "Từ lập trình, ngoại ngữ đến thiết kế, kinh doanh và kỹ năng mềm.") })
        {
            <div class="home-category-card">
                <span class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center"><i data-lucide="@v.Item1" class="w-6 h-6"></i></span>
                <strong class="mt-4 text-lg font-extrabold text-slate-900">@v.Item2</strong>
                <span class="mt-2 text-sm text-slate-500">@v.Item3</span>
            </div>
        }
    </div>
</section>

<!-- Cách hoạt động -->
<section class="home-soft-bg py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-black text-slate-900 text-center">EduFlow hoạt động như thế nào?</h2>
        <div class="mt-10 grid md:grid-cols-3 gap-6">
            @foreach (var step in new[] {
                ("01", "Tạo tài khoản", "Đăng ký miễn phí bằng email hoặc tài khoản Google."),
                ("02", "Chọn khóa học", "Lọc theo lĩnh vực, cấp độ, học phí và xem thử bài học miễn phí."),
                ("03", "Học và tiến bộ", "Học theo từng chương, làm bài kiểm tra và theo dõi tiến độ.") })
            {
                <div class="rounded-2xl bg-white border border-slate-100 p-7 shadow-sm">
                    <span class="text-4xl font-black text-blue-200">@step.Item1</span>
                    <h3 class="mt-3 text-lg font-extrabold text-slate-900">@step.Item2</h3>
                    <p class="mt-2 text-slate-500">@step.Item3</p>
                </div>
            }
        </div>
    </div>
</section>

<!-- Kêu gọi -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="rounded-3xl bg-navy-900 text-white overflow-hidden grid lg:grid-cols-2 items-center">
        <div class="p-10 sm:p-14">
            <h2 class="text-3xl font-black leading-tight">Sẵn sàng bắt đầu <span class="text-amber-300">hành trình học tập</span>?</h2>
            <p class="mt-4 text-slate-300">Tạo tài khoản miễn phí và khám phá các khóa học ngay hôm nay.</p>
            <div class="mt-8 flex flex-wrap gap-3">
                <a href="/Account/Register" class="btn-amber">Đăng ký miễn phí</a>
                <a href="/Courses" class="btn-outline">Xem khóa học</a>
            </div>
        </div>
        <div class="hidden lg:flex h-full min-h-[280px] bg-gradient-to-br from-blue-500 to-blue-800 items-center justify-center p-8">
            <img src="~/images/illustration-hero.svg" alt="" class="w-full max-w-sm" />
        </div>
    </div>
</section>
