@model HomePageViewModel
@{
    ViewData["Title"] = "Dạy học cùng EduFlow";
    ViewData["FullWidth"] = true;

    // Nút chính đổi theo người đang xem:
    // chưa đăng nhập -> đăng ký tài khoản (xong tự sang trang hồ sơ giảng viên)
    // đã là giảng viên -> vào Studio, còn lại -> gửi hồ sơ giảng viên
    var loggedIn = User.Identity?.IsAuthenticated == true;
    var isInstructor = User.IsInRole(AppRoles.Instructor);
    var ctaUrl = !loggedIn ? "/Account/Register?returnUrl=%2FKyc" : isInstructor ? "/Instructor" : "/Kyc";
    var ctaText = !loggedIn ? "Đăng ký làm giảng viên" : isInstructor ? "Vào Studio giảng viên" : "Gửi hồ sơ giảng viên";
}

<!-- ================= GIỚI THIỆU ================= -->
<section class="teach-hero">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 grid lg:grid-cols-2 gap-10 items-center">
        <div>
            <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 border border-white/20 text-xs font-bold text-amber-300">
                <i data-lucide="presentation" class="w-4 h-4"></i> DẠY HỌC CÙNG EDUFLOW
            </span>
            <h1 class="mt-5 text-4xl sm:text-5xl font-black leading-tight text-white">
                Chia sẻ kiến thức,<br /><span class="text-amber-300">tạo thu nhập</span> từ chuyên môn của bạn
            </h1>
            <p class="mt-5 text-lg text-blue-100 max-w-xl">
                Xây dựng khóa học trực tuyến theo cách của bạn, tiếp cận học viên ở mọi nơi và nhận
                <b class="text-white">70% doanh thu</b> từ mỗi khóa học bán được.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
                <a href="@ctaUrl" class="btn-amber">@ctaText <i data-lucide="arrow-right" class="w-4 h-4"></i></a>
                <a href="#cac-buoc" class="teach-ghost">Xem các bước</a>
            </div>
            @if (!loggedIn)
            {
                <p class="mt-4 text-sm text-blue-200">Đã có tài khoản? <a href="/Account/Login?returnUrl=%2FKyc" class="font-bold text-white underline">Đăng nhập để gửi hồ sơ</a></p>
            }
        </div>
        <img src="~/images/illustration-teach.svg" alt="" class="hidden lg:block w-full max-w-md ml-auto" />
    </div>
</section>

<!-- Số liệu thật -->
<section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 -mt-10 relative">
    <div class="grid grid-cols-3 gap-4">
        <div class="hero-stat py-5"><strong>@Model.TotalInstructors</strong><span>giảng viên đang dạy</span></div>
        <div class="hero-stat py-5"><strong>@Model.TotalCourses</strong><span>khóa học đã xuất bản</span></div>
        <div class="hero-stat py-5"><strong>@Model.TotalStudents</strong><span>học viên đã đăng ký</span></div>
    </div>
</section>

<!-- ================= QUYỀN LỢI ================= -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center max-w-2xl mx-auto">
        <h2 class="text-3xl font-black text-slate-900">Quyền lợi khi trở thành giảng viên</h2>
        <p class="mt-3 text-slate-600">EduFlow lo phần nền tảng, bạn tập trung vào điều bạn giỏi nhất: giảng dạy.</p>
    </div>
    <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var b in new[] {
            ("wallet", "Hưởng 70% doanh thu", "Giảng viên nhận 70% giá bán của mỗi khóa học. Tỷ lệ được chốt tại thời điểm học viên mua, không thay đổi về sau."),
            ("landmark", "Rút tiền về ngân hàng", "Doanh thu cộng vào số dư của bạn. Gửi yêu cầu rút tiền về tài khoản ngân hàng đã đăng ký trong hồ sơ."),
            ("clapperboard", "Công cụ soạn bài đầy đủ", "Bài giảng video (YouTube hoặc tải lên), bài viết có định dạng, bài kiểm tra trắc nghiệm / điền khuyết, tài liệu đính kèm."),
            ("layout-list", "Tự xây lộ trình học", "Chia khóa học thành chương và bài, kéo thả để sắp xếp, chọn bài cho học thử miễn phí để thu hút học viên."),
            ("tag", "Tự đặt giá và khuyến mãi", "Khóa học miễn phí hoặc trả phí, đặt giá khuyến mãi theo khoảng thời gian bạn muốn."),
            ("shield-check", "Được kiểm duyệt và hỗ trợ", "Đội ngũ quản trị duyệt nội dung trước khi xuất bản, góp ý cụ thể khi khóa học cần chỉnh sửa.") })
        {
            <div class="teach-benefit">
                <span class="teach-benefit-icon"><i data-lucide="@b.Item1" class="w-6 h-6"></i></span>
                <h3>@b.Item2</h3>
                <p>@b.Item3</p>
            </div>
        }
    </div>
</section>

<!-- ================= ĐIỀU KIỆN ================= -->
<section class="home-soft-bg py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-10 items-center">
        <div>
            <h2 class="text-3xl font-black text-slate-900">Bạn cần chuẩn bị gì?</h2>
            <p class="mt-3 text-slate-600">Hồ sơ định danh (KYC) giúp EduFlow bảo đảm chất lượng giảng viên và chuyển doanh thu đúng người.</p>
            <ul class="mt-6 space-y-4">
                @foreach (var r in new[] {
                    ("Chuyên môn rõ ràng", "Một chức danh / lĩnh vực bạn muốn giảng dạy, ví dụ \"Giáo viên tiếng Anh 5 năm kinh nghiệm\"."),
                    ("Căn cước công dân", "Số CCCD gồm 12 chữ số để xác minh danh tính."),
                    ("Tài khoản ngân hàng", "Tên ngân hàng, số tài khoản và tên chủ tài khoản để nhận doanh thu."),
                    ("Mã số thuế (không bắt buộc)", "Nếu có, giúp việc kê khai thu nhập thuận tiện hơn.") })
                {
                    <li class="flex gap-3">
                        <span class="mt-0.5 w-6 h-6 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0"><i data-lucide="check" class="w-4 h-4"></i></span>
                        <div><b class="text-slate-900">@r.Item1</b><p class="text-sm text-slate-500">@r.Item2</p></div>
                    </li>
                }
            </ul>
        </div>
        <img src="~/images/illustration-desk.svg" alt="" class="w-full max-w-lg mx-auto" />
    </div>
</section>

<!-- ================= CÁC BƯỚC ================= -->
<section id="cac-buoc" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="text-3xl font-black text-slate-900 text-center">4 bước để bắt đầu giảng dạy</h2>
    <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        @foreach (var s in new[] {
            ("1", "user-plus", "Tạo tài khoản", "Đăng ký miễn phí bằng email hoặc tài khoản Google."),
            ("2", "file-check", "Gửi hồ sơ giảng viên", "Điền chuyên môn, CCCD và tài khoản ngân hàng trong trang hồ sơ."),
            ("3", "badge-check", "Chờ quản trị viên duyệt", "Được duyệt, tài khoản có thêm quyền giảng viên. Bị từ chối sẽ có lý do để bạn bổ sung."),
            ("4", "rocket", "Tạo và xuất bản khóa học", "Soạn chương bài trong Studio, gửi duyệt và bắt đầu đón học viên.") })
        {
            <div class="teach-step">
                <span class="teach-step-number">@s.Item1</span>
                <i data-lucide="@s.Item2" class="w-7 h-7 text-blue-600"></i>
                <h3>@s.Item3</h3>
                <p>@s.Item4</p>
            </div>
        }
    </div>
    <div class="mt-10 text-center">
        <a href="@ctaUrl" class="btn-primary">@ctaText <i data-lucide="arrow-right" class="w-4 h-4"></i></a>
    </div>
</section>

<!-- ================= CÂU HỎI THƯỜNG GẶP ================= -->
<section class="home-soft-bg py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-black text-slate-900 text-center">Câu hỏi thường gặp</h2>
        <div class="mt-8 space-y-3">
            @foreach (var f in new[] {
                ("Đăng ký làm giảng viên có mất phí không?", "Không. Tạo tài khoản, gửi hồ sơ và tạo khóa học đều miễn phí. EduFlow chỉ giữ 30% doanh thu khi khóa học của bạn bán được."),
                ("Bao lâu thì hồ sơ được duyệt?", "Quản trị viên xét duyệt hồ sơ theo thứ tự gửi. Kết quả hiện ngay trong trang hồ sơ giảng viên của bạn."),
                ("Hồ sơ bị từ chối thì sao?", "Bạn sẽ thấy lý do từ chối, chỉ cần sửa thông tin và gửi lại."),
                ("Tôi vẫn học được các khóa khác chứ?", "Có. Khi được duyệt, tài khoản có thêm quyền giảng viên nhưng vẫn giữ quyền học viên."),
                ("Khóa học có cần duyệt trước khi bán?", "Có. Sau khi soạn xong, bạn gửi duyệt; quản trị viên kiểm tra nội dung rồi mới xuất bản.") })
            {
                <details class="teach-faq">
                    <summary>@f.Item1 <i data-lucide="chevron-down" class="w-5 h-5"></i></summary>
                    <p>@f.Item2</p>
                </details>
            }
        </div>
    </div>
</section>

<!-- ================= KÊU GỌI ================= -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="rounded-3xl bg-navy-900 text-white p-10 sm:p-14 text-center">
        <h2 class="text-3xl sm:text-4xl font-black">Sẵn sàng <span class="text-amber-300">chia sẻ kiến thức</span>?</h2>
        <p class="mt-4 text-slate-300 max-w-xl mx-auto">Chỉ mất vài phút để tạo tài khoản và gửi hồ sơ giảng viên.</p>
        <a href="@ctaUrl" class="btn-amber mt-8">@ctaText <i data-lucide="arrow-right" class="w-4 h-4"></i></a>
    </div>
</section>
