@model List<EduFlow.Web.Helpers.PreviewMail>
@{ViewData["Title"]="Hộp thư mô phỏng";}
<div class="page-heading"><div><span class="eyebrow">THÔNG BÁO EDUFLOW</span><h1>Hộp thư mô phỏng</h1><p class="muted">Email lưu tại máy để thực hành, không gửi ra địa chỉ thật. Hiển thị tối đa 200 thư mới nhất.</p></div>@if(ViewBag.IsAdmin==true){<a class="button secondary" asp-route-all="@(!(bool)ViewBag.All)">@(ViewBag.All?"Thư của tôi":"Xem mọi thư (admin)")</a>}</div>
@foreach(var mail in Model){<article class="panel" style="margin-bottom:16px"><h2><a asp-action="Message" asp-route-id="@mail.Id">@mail.Subject</a></h2><p class="muted">Đến: @mail.To · @mail.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p></article>}
@if(Model.Count==0){<section class="panel">Chưa có email mô phỏng.</section>}
