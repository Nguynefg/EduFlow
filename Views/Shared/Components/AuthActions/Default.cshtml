@model User?
@if (Model == null)
{
    <a class="px-4 py-2.5 rounded-xl border-2 border-blue-600 text-blue-600 text-sm font-bold hover:bg-blue-50" asp-area="" asp-controller="Account" asp-action="Login">Đăng nhập</a>
    <a class="hidden sm:inline-block px-4 py-2.5 rounded-xl border-2 border-blue-600 bg-blue-600 text-white text-sm font-bold shadow-md shadow-blue-500/20 hover:bg-blue-700" asp-area="" asp-controller="Account" asp-action="Register">Đăng ký ngay</a>
}
else
{
    <a class="inline-flex items-center min-h-10 text-sm leading-5 font-bold text-blue-600 whitespace-nowrap" asp-area="" asp-controller="Cart" asp-action="Index">Giỏ hàng</a>
    @if (User.IsInRole(AppRoles.Admin))
    {
        <a class="inline-flex items-center min-h-10 text-sm leading-5 font-bold text-blue-600 whitespace-nowrap" asp-area="Admin" asp-controller="Home" asp-action="Index">Quản trị</a>
    }
    @if (User.IsInRole(AppRoles.Instructor))
    {
        <a class="inline-flex items-center min-h-10 text-sm leading-5 font-bold text-blue-600 whitespace-nowrap" asp-area="" asp-controller="Instructor" asp-action="Index">Studio giảng viên</a>
    }
    <details class="account-menu relative">
        <summary class="flex items-center gap-2 cursor-pointer list-none rounded-full border border-blue-200 px-2 py-1 text-xs font-bold">
            @if (!string.IsNullOrEmpty(Model.AvatarUrl))
            {
                <img src="@Model.AvatarUrl" alt="" class="w-8 h-8 rounded-full object-cover" />
            }
            else
            {
                <span class="w-8 h-8 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center">@Model.FullName.FirstOrDefault()</span>
            }
            <span class="hidden xl:inline">@Model.FullName</span>
            <i data-lucide="chevron-down" class="w-3 h-3"></i>
        </summary>
        <div class="absolute right-0 top-full mt-2 w-64 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 shadow-xl p-3 z-50 space-y-1">
            <p class="font-bold text-sm px-2">@Model.FullName</p>
            <p class="text-xs text-slate-500 px-2 pb-2 break-all">@Model.Email</p>
            <a class="block px-2 py-2 rounded-lg hover:bg-blue-50 dark:hover:bg-slate-800 text-sm font-semibold" asp-area="" asp-controller="Learning" asp-action="Index">Khóa học đã mua</a>
            <a class="block px-2 py-2 rounded-lg hover:bg-blue-50 dark:hover:bg-slate-800 text-sm" asp-area="" asp-controller="Profile" asp-action="Index">Thông tin cá nhân</a>
            <a class="block px-2 py-2 rounded-lg hover:bg-blue-50 dark:hover:bg-slate-800 text-sm" asp-area="" asp-controller="Profile" asp-action="ChangePassword">Đổi mật khẩu</a>
            @if (User.IsInRole(AppRoles.Instructor))
            {
                <a class="block px-2 py-2 rounded-lg hover:bg-blue-50 dark:hover:bg-slate-800 text-sm" asp-area="" asp-controller="Instructor" asp-action="Index">Khóa học tôi dạy</a>
            }
            else
            {
                <a class="block px-2 py-2 rounded-lg hover:bg-blue-50 dark:hover:bg-slate-800 text-sm" asp-area="" asp-controller="Kyc" asp-action="Index">
                    @(Model.InstructorProfile?.KycStatus == KycStatus.Pending ? "Hồ sơ giảng viên đang chờ duyệt" : "Đăng ký làm giảng viên")
                </a>
            }
            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                <button class="w-full text-left px-2 py-2 text-sm text-rose-600 font-bold">Đăng xuất</button>
            </form>
        </div>
    </details>
}
