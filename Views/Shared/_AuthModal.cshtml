@if (User.Identity?.IsAuthenticated != true && ViewContext.RouteData.Values["controller"]?.ToString() != "Account") {
<dialog id="authModal" aria-labelledby="authModalTitle" class="w-[calc(100%-2rem)] max-w-md p-0 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 shadow-2xl backdrop:bg-slate-900/60 backdrop:backdrop-blur-sm">
<div class="p-6 sm:p-8 relative"><button type="button" data-ui-action="close-auth" aria-label="Đóng" class="absolute top-4 right-4 text-slate-400 hover:text-blue-600 p-2"><i data-lucide="x" class="w-5 h-5"></i></button><div class="text-center mb-5"><div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-600 mx-auto flex items-center justify-center mb-2"><i data-lucide="graduation-cap" class="w-6 h-6"></i></div><h2 id="authModalTitle" class="text-xl font-black text-slate-900 dark:text-white">Đăng nhập EduFlow</h2><p class="text-xs text-slate-500 mt-1">Cùng bắt đầu hành trình kiến thức của bạn.</p></div>
<div class="flex items-center p-1 bg-slate-100 dark:bg-slate-800 rounded-2xl mb-5"><button type="button" data-auth-tab="login" data-ui-action="auth-login" class="flex-1 py-2 rounded-xl text-xs font-bold">Đăng nhập</button><button type="button" data-auth-tab="register" data-ui-action="auth-register" class="flex-1 py-2 rounded-xl text-xs font-bold">Đăng ký</button></div>
<form id="modalLoginForm" asp-controller="Account" asp-action="Login" method="post" class="auth-form space-y-4"><input type="hidden" name="ReturnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" /><div><label for="modalLoginEmail">Email</label><input id="modalLoginEmail" name="Email" type="email" autocomplete="username" required /></div><div><label for="modalLoginPassword">Mật khẩu</label><div class="auth-password-field"><input id="modalLoginPassword" name="Password" type="password" autocomplete="current-password" required /><partial name="_PasswordToggle" model='("modalLoginPassword", "mật khẩu")' /></div></div><div class="flex flex-wrap items-center justify-between gap-2"><label class="flex items-center gap-2 text-xs"><input name="RememberMe" value="true" type="checkbox" /> Ghi nhớ đăng nhập</label><a asp-controller="Password" asp-action="Forgot" class="text-xs font-semibold text-blue-600 dark:text-blue-300 hover:underline">Quên mật khẩu?</a></div><button class="w-full py-3 bg-gradient-to-r from-blue-600 to-sky-600 text-white font-extrabold text-sm rounded-xl">Đăng nhập</button></form>
<form id="modalRegisterForm" asp-controller="Account" asp-action="Register" method="post" class="auth-form space-y-3 hidden"><div><label for="modalRegisterName">Họ và tên</label><input id="modalRegisterName" name="FullName" autocomplete="name" maxlength="100" required /></div><div><label for="modalRegisterEmail">Email</label><input id="modalRegisterEmail" name="Email" type="email" autocomplete="email" required /></div><div><label for="modalRegisterPassword">Mật khẩu</label><div class="auth-password-field"><input id="modalRegisterPassword" name="Password" type="password" autocomplete="new-password" minlength="10" maxlength="100" required /><partial name="_PasswordToggle" model='("modalRegisterPassword", "mật khẩu")' /></div><p class="text-[11px] text-slate-500 mt-1">Ít nhất 10 ký tự, có chữ hoa, chữ thường, số và ký tự đặc biệt.</p></div><div><label for="modalRegisterConfirm">Nhập lại mật khẩu</label><div class="auth-password-field"><input id="modalRegisterConfirm" name="ConfirmPassword" type="password" autocomplete="new-password" minlength="10" maxlength="100" required /><partial name="_PasswordToggle" model='("modalRegisterConfirm", "mật khẩu nhập lại")' /></div></div><button class="w-full py-3 bg-gradient-to-r from-blue-600 to-sky-600 text-white font-extrabold text-sm rounded-xl">Tạo tài khoản học viên</button></form>
</div></dialog>
}
