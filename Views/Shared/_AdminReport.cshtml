@model EduFlow.Web.Models.ViewModels.AdminReportViewModel
@{var report=Model.Revenue;var points=Model.Days.Count>62?Model.Days.GroupBy(d=>new{d.Date.Year,d.Date.Month}).Select(g=>new EduFlow.Web.Models.ViewModels.DailyReportRow{Date=new DateTime(g.Key.Year,g.Key.Month,1),Revenue=g.Sum(d=>d.Revenue)}).ToList():Model.Days;var max=points.Count==0?0:points.Max(d=>d.Revenue);}
<section class="rp-panel"><div class="rp-heading"><div><h2>Doanh thu và tăng trưởng</h2><p>@(report.IsTest?"Dữ liệu mô phỏng":"Dữ liệu tiền thật") · Theo ngày tạo đơn</p></div><span class="rp-badge">@report.From.ToString("dd/MM/yyyy") – @report.To.ToString("dd/MM/yyyy")</span></div>
<form method="get" class="rp-filter"><div><label for="report-from">Từ ngày</label><input id="report-from" name="from" type="date" value="@report.From.ToString("yyyy-MM-dd")" required/></div><div><label for="report-to">Đến ngày</label><input id="report-to" name="to" type="date" value="@report.To.ToString("yyyy-MM-dd")" required/></div><button class="button">Xem báo cáo</button><a class="button secondary" asp-controller="Reports" asp-action="Revenue" asp-route-from="@report.From.ToString("yyyy-MM-dd")" asp-route-to="@report.To.ToString("yyyy-MM-dd")">Excel doanh thu</a><a class="button secondary" asp-controller="Reports" asp-action="Users" asp-route-from="@report.From.ToString("yyyy-MM-dd")" asp-route-to="@report.To.ToString("yyyy-MM-dd")">Excel người dùng</a></form>
<div class="rp-stats"><div><span>Tiền bán trong kỳ</span><strong>@UiText.Money(report.Revenue)</strong></div><div><span>Phần nền tảng giữ</span><strong>@UiText.Money(report.PlatformIncome)</strong></div><div><span>Khóa học bán ra</span><strong>@report.Sales</strong></div><div><span>Người dùng mới</span><strong>@Model.NewUsers</strong></div></div>
<p class="muted">Biểu đồ doanh thu @(Model.Days.Count>62?"theo tháng":"theo ngày"). Số liệu chi tiết ở bên dưới.</p><div class="rp-chart" aria-hidden="true">@foreach(var day in points){var height=(max==0?0:day.Revenue/max*100).ToString("0.##",System.Globalization.CultureInfo.InvariantCulture)+"%";<div title="@day.Date.ToString("dd/MM"): @UiText.Money(day.Revenue)"><i style="height:@height"></i></div>}</div>
<details class="rp-details"><summary>Xem số liệu theo ngày · @Model.Orders đơn đã thanh toán</summary><div class="rp-table" tabindex="0" role="region" aria-label="Báo cáo theo ngày"><table><thead><tr><th scope="col">Ngày</th><th scope="col">Tiền bán</th><th scope="col">Đơn hàng</th><th scope="col">Lượt mua</th><th scope="col">Người dùng mới</th></tr></thead><tbody>@foreach(var day in Model.Days){<tr><td>@day.Date.ToString("dd/MM/yyyy")</td><td>@UiText.Money(day.Revenue)</td><td>@day.Orders</td><td>@day.Sales</td><td>@day.NewUsers</td></tr>}</tbody></table></div></details>
</section>
