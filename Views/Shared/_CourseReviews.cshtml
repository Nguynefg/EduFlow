@model ReviewsViewModel
<section id="reviews" class="cm-card cm-reviews">
<div class="cm-heading"><div><span class="eyebrow">TRẢI NGHIỆM HỌC VIÊN</span><h2>Đánh giá khóa học</h2></div><span class="cm-badge">@Model.Total đánh giá</span></div>
<div class="cm-rating-summary"><div class="cm-rating-score"><strong>@Model.Average.ToString("0.0")</strong><span>trên 5 sao</span><small>Chỉ tính đánh giá đang hiển thị</small></div><div class="cm-rating-bars">
@for(byte star=5;star>=1;star--){var count=Model.Stars.GetValueOrDefault(star);var width=(Model.Total==0?0:count*100m/Model.Total).ToString("0.##",System.Globalization.CultureInfo.InvariantCulture)+"%";<div><span>@star sao</span><span class="cm-bar" aria-hidden="true"><i style="width:@width"></i></span><span>@count</span></div>}
</div></div>
@if(Model.CanReview){<details class="cm-editor" open="@(Model.Mine==null)"><summary>@(Model.Mine==null?"Viết đánh giá của bạn":"Sửa đánh giá của bạn")</summary>
@if(Model.Mine?.IsHidden==true){<p class="cm-note">Đánh giá của bạn đang bị ẩn. Sửa nội dung không tự hiển thị lại.</p>}
<form asp-controller="Community" asp-action="Review" asp-area="" method="post"><input type="hidden" name="courseId" value="@Model.CourseId" /><label for="review-rating">Số sao</label><select id="review-rating" name="rating">@for(var s=5;s>=1;s--){<option value="@s" selected="@((Model.Mine?.Rating??5)==s)">@s sao</option>}</select><label for="review-comment">Nhận xét của bạn</label><textarea id="review-comment" name="comment" rows="3" maxlength="3000" placeholder="Chia sẻ điều bạn học được và góp ý cho khóa học">@Model.Mine?.Comment</textarea><button class="button">Lưu đánh giá</button></form></details>}
else if(!Model.CanReply){<p class="cm-note">Bạn cần đăng ký và hoàn thành ít nhất 30% khóa học để đánh giá. @if(User.Identity?.IsAuthenticated==true){<span>Tiến độ hiện tại: @Model.Percent%.</span>}</p>}
@if(Model.Total==0){<div class="cm-empty"><i data-lucide="message-square-heart" aria-hidden="true"></i><p>Chưa có đánh giá. Trải nghiệm của bạn sẽ giúp các học viên khác chọn khóa học phù hợp.</p></div>}
@foreach(var review in Model.Items){<article class="cm-review"><header><strong>@(review.User?.DeletedAt==null?review.User?.FullName:"Người dùng")</strong><span>@review.Rating / 5 sao · @review.CreatedAt.ToString("dd/MM/yyyy")</span></header><p class="cm-text">@review.Comment</p>
@if(!string.IsNullOrWhiteSpace(review.InstructorReply)){<div class="cm-reply"><strong>Phản hồi từ khóa học</strong><p class="cm-text">@review.InstructorReply</p></div>}
@if(Model.CanReply){<details class="cm-editor"><summary>Phản hồi đánh giá</summary><form asp-controller="Community" asp-action="ReviewReply" asp-area="" method="post"><input type="hidden" name="courseId" value="@Model.CourseId"/><input type="hidden" name="reviewerId" value="@review.UserId"/><label for="reply-review-@review.UserId">Nội dung phản hồi</label><textarea id="reply-review-@review.UserId" name="reply" maxlength="3000" rows="2" required>@review.InstructorReply</textarea><button class="button small">Lưu phản hồi</button></form></details>}
</article>}
@if(Model.Pages>1){<nav class="cm-pages" aria-label="Trang đánh giá">@if(Model.Page>1){<a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.CourseId" asp-route-reviewPage="@(Model.Page-1)" asp-fragment="reviews">Trang trước</a>}<span>@Model.Page / @Model.Pages</span>@if(Model.Page<Model.Pages){<a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.CourseId" asp-route-reviewPage="@(Model.Page+1)" asp-fragment="reviews">Trang sau</a>}</nav>}
</section>
