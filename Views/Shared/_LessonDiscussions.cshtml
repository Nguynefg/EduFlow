@model DiscussionViewModel
<section id="qa" class="cm-qa">
<div class="cm-heading"><div><h2>Hỏi đáp bài học</h2><p>Trao đổi cùng giảng viên và các học viên khác.</p></div><span class="cm-badge">@Model.Total câu hỏi</span></div>
<form method="get" asp-controller="@(Model.InLearn?"Learning":"Community")" asp-action="@(Model.InLearn?"Learn":"Lesson")" asp-fragment="qa" class="cm-search"><input type="hidden" name="id" value="@(Model.InLearn?Model.CourseId:Model.Lesson.Id)"/>@if(Model.InLearn){<input type="hidden" name="lessonId" value="@Model.Lesson.Id"/>}<label for="qa-search">Tìm câu hỏi hoặc câu trả lời</label><div><input id="qa-search" name="q" value="@Model.Query" maxlength="100" placeholder="Nhập từ khóa cần tìm"/><button class="button secondary">Tìm kiếm</button></div></form>
<details class="cm-editor"><summary><i data-lucide="message-circle-plus" aria-hidden="true"></i>Đặt câu hỏi mới</summary><form asp-controller="Community" asp-action="Post" asp-area="" method="post"><partial name="_DiscussionContext" model="Model"/><label for="qa-title">Tiêu đề</label><input id="qa-title" name="title" maxlength="255" required/><label for="qa-content">Nội dung câu hỏi</label><textarea id="qa-content" name="content" rows="4" maxlength="5000" required></textarea>@if(Model.Lesson.LessonType==LessonType.Video){<label for="qa-timestamp">Mốc thời gian trong video (giây, không bắt buộc)</label><input id="qa-timestamp" name="timestamp" type="number" min="0" max="@Model.Lesson.DurationSec" step="1" placeholder="Ví dụ: 90 tương ứng 01:30"/>}<button class="button">Gửi câu hỏi</button></form></details>
@if(Model.Questions.Count==0){<div class="cm-empty"><i data-lucide="messages-square" aria-hidden="true"></i><p>@(string.IsNullOrEmpty(Model.Query)?"Chưa có câu hỏi. Hãy bắt đầu cuộc trao đổi cho bài học này.":"Không có câu hỏi phù hợp với từ khóa.")</p></div>}
@foreach(var question in Model.Questions){<article class="cm-question"><partial name="_DiscussionItem" model="@(new DiscussionItemViewModel{Item=question,Page=Model})"/>
<div class="cm-answers">@foreach(var answer in Model.Answers.Where(a=>a.ParentId==question.Id)){<partial name="_DiscussionItem" model="@(new DiscussionItemViewModel{Item=answer,Page=Model})"/>}</div>
@if(!question.IsHidden){<details class="cm-editor"><summary>Trả lời câu hỏi</summary><form asp-controller="Community" asp-action="Post" asp-area="" method="post"><partial name="_DiscussionContext" model="Model"/><input type="hidden" name="parentId" value="@question.Id"/><label for="answer-@question.Id">Câu trả lời của bạn</label><textarea id="answer-@question.Id" name="content" rows="3" maxlength="5000" required></textarea><button class="button small">Gửi trả lời</button></form></details>}
</article>}
@if(Model.Pages>1){<nav class="cm-pages" aria-label="Trang hỏi đáp">@if(Model.Page>1){<a asp-controller="@(Model.InLearn?"Learning":"Community")" asp-action="@(Model.InLearn?"Learn":"Lesson")" asp-route-id="@(Model.InLearn?Model.CourseId:Model.Lesson.Id)" asp-route-lessonId="@Model.Lesson.Id" asp-route-q="@Model.Query" asp-route-qaPage="@(Model.Page-1)" asp-fragment="qa">Trang trước</a>}<span>@Model.Page / @Model.Pages</span>@if(Model.Page<Model.Pages){<a asp-controller="@(Model.InLearn?"Learning":"Community")" asp-action="@(Model.InLearn?"Learn":"Lesson")" asp-route-id="@(Model.InLearn?Model.CourseId:Model.Lesson.Id)" asp-route-lessonId="@Model.Lesson.Id" asp-route-q="@Model.Query" asp-route-qaPage="@(Model.Page+1)" asp-fragment="qa">Trang sau</a>}</nav>}
</section>
