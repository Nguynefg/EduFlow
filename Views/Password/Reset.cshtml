@model ResetPasswordViewModel
@{ViewData["Title"]="Đặt lại mật khẩu";}
<h1>Đặt lại mật khẩu</h1><form method="post"><div asp-validation-summary="All" class="validation"></div><input asp-for="Token" type="hidden"/><label asp-for="Password">Mật khẩu mới</label><input asp-for="Password" type="password" autocomplete="new-password" required/><span asp-validation-for="Password" class="validation"></span><label asp-for="ConfirmPassword">Xác nhận mật khẩu</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required/><span asp-validation-for="ConfirmPassword" class="validation"></span><button class="button">Lưu mật khẩu mới</button></form>
