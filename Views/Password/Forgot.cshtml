@model ForgotPasswordViewModel
@{ ViewData["Title"] = "Quên mật khẩu"; }

<h2 class="auth-title">Quên mật khẩu</h2>

@if (ViewBag.Sent == true)
{
    <p class="auth-subtitle">Nếu email thuộc một tài khoản đang hoạt động, hệ thống đã gửi liên kết đặt lại mật khẩu vào email đó. Mở liên kết trong thư để chọn mật khẩu mới.</p>
    <a asp-controller="Account" asp-action="Login" class="auth-button text-center mt-6">Về trang đăng nhập</a>
}
else
{
    <p class="auth-subtitle">Nhập email đã đăng ký, hệ thống sẽ gửi liên kết đặt lại mật khẩu cho bạn.</p>
    <form asp-action="Forgot" method="post" class="auth-form">
        <label asp-for="Email" ></label>
        <input asp-for="Email" class="auth-input" placeholder="Email" autocomplete="email" />
        <span asp-validation-for="Email" class="validation"></span>
        <button class="auth-button">Gửi liên kết đặt lại mật khẩu</button>
        <a asp-controller="Account" asp-action="Login" class="auth-link">← Quay lại đăng nhập</a>
    </form>
}

