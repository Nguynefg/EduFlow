@model MyCoursesViewModel
@{
    ViewData["Title"]="Tổng quan học tập";
    var span=TimeSpan.FromSeconds(Model.StudySeconds);
    var recent=Model.Items.FirstOrDefault(i=>i.IsStarted&&!i.IsCompleted&&i.LessonCount>0)??Model.Items.FirstOrDefault(i=>!i.IsCompleted&&i.LessonCount>0);
    var lessons=Model.Items.Sum(i=>i.LessonCount);
    var overall=lessons==0?0:(int)Math.Round(Model.TotalCompletedLessons*100d/lessons,MidpointRounding.AwayFromZero);
}
@section Styles {<link rel="stylesheet" href="~/css/student-dashboard.css" asp-append-version="true"/>}
@section Scripts {<script src="~/js/student-dashboard.js" asp-append-version="true"></script>}
<div class="student-dashboard">
<header class="sd-heading"><div><span class="eyebrow">KHÔNG GIAN HỌC TẬP</span><h1>Tổng quan học tập</h1><p>Tiếp tục bài đang học và theo dõi những gì bạn đã hoàn thành.</p></div><a class="button secondary" asp-controller="Courses" asp-action="Index"><i data-lucide="compass" aria-hidden="true"></i>Khám phá khóa học</a></header>
@if(recent!=null){<section class="sd-hero"><div><span class="sd-eyebrow">@(recent.IsStarted?"TIẾP TỤC HÀNH TRÌNH":"BẮT ĐẦU HỌC HÔM NAY")</span><h2>@recent.Course.Title</h2><p class="sd-current"><i data-lucide="play-circle" aria-hidden="true"></i>@recent.ContinueLessonTitle</p>
@if(recent.ResumePositionSec>0){<p class="sd-resume"><i data-lucide="bookmark-check" aria-hidden="true"></i>Vị trí đã lưu @UiText.Duration(recent.ResumePositionSec) · đã xem @recent.WatchedPercent% video này</p>}
<div class="sd-hero-progress"><span>@recent.CompletedLessons/@recent.LessonCount bài hoàn thành</span><strong>@recent.Percent%</strong><progress value="@recent.Percent" max="100" aria-label="Tiến độ khóa @recent.Course.Title">@recent.Percent%</progress></div>
<a class="button" asp-controller="Learning" asp-action="Learn" asp-route-id="@recent.Course.Id" asp-route-lessonId="@recent.ContinueLessonId"><i data-lucide="play" aria-hidden="true"></i>@(recent.IsStarted?"Tiếp tục học":"Bắt đầu học")</a></div><div class="sd-hero-cover"><partial name="_CourseCover" model="recent.Course"/></div></section>}
else{<section class="sd-welcome"><i data-lucide="graduation-cap" aria-hidden="true"></i><div><h2>@(Model.CompletedCount>0?"Bạn đã hoàn thành "+Model.CompletedCount+" khóa học!":"Sẵn sàng cho bài học đầu tiên?")</h2><p>@(Model.TotalCount==0?"Chọn một khóa học phù hợp và bắt đầu hành trình của bạn.":"Các khóa học và bài ôn tập của bạn nằm ở bên dưới.")</p></div></section>}
<div class="sd-stats"><section class="sd-card"><span class="sd-stat-icon"><i data-lucide="library-big" aria-hidden="true"></i></span><div><strong>@Model.TotalCount</strong><span>Khóa đã đăng ký</span></div></section><section class="sd-card"><span class="sd-stat-icon sd-amber"><i data-lucide="flame" aria-hidden="true"></i></span><div><strong>@Model.LearningCount</strong><span>Đang học</span></div></section><section class="sd-card"><span class="sd-stat-icon sd-green"><i data-lucide="trophy" aria-hidden="true"></i></span><div><strong>@Model.CompletedCount</strong><span>Đã hoàn thành</span></div></section><section class="sd-card"><span class="sd-stat-icon sd-sky"><i data-lucide="clock-3" aria-hidden="true"></i></span><div><strong>@((long)span.TotalHours)<small> giờ </small>@span.Minutes<small> phút</small></strong><span>Thời gian đã ghi nhận</span></div></section></div>
<div class="sd-layout"><section class="sd-card sd-courses"><div class="sd-section-heading"><div><h2>Khóa học của bạn</h2><p>Tiến độ được lấy từ các bài học đã lưu trong hệ thống.</p></div><a asp-controller="Learning" asp-action="Index">Xem tất cả<i data-lucide="arrow-right" aria-hidden="true"></i></a></div>
<div class="sd-tools"><div class="sd-filters" role="group" aria-label="Lọc tiến độ khóa học"><button type="button" class="is-active" data-study-filter="all" aria-pressed="true">Tất cả <span>@Model.TotalCount</span></button><button type="button" data-study-filter="learning" aria-pressed="false">Đang học <span>@Model.LearningCount</span></button><button type="button" data-study-filter="not-started" aria-pressed="false">Chưa học <span>@Model.NotStartedCount</span></button><button type="button" data-study-filter="completed" aria-pressed="false">Hoàn thành <span>@Model.CompletedCount</span></button></div><label class="sd-search"><i data-lucide="search" aria-hidden="true"></i><span class="sd-sr-only">Tìm khóa học hoặc giảng viên</span><input type="search" maxlength="100" data-study-search placeholder="Tìm khóa học, giảng viên..."/></label></div>
<div class="sd-course-list">@foreach(var item in Model.Items){var state=item.IsCompleted?"completed":item.IsStarted?"learning":"not-started";<article class="sd-course" data-study-state="@state" data-study-name="@(item.Course.Title+" "+item.Course.Instructor?.FullName)"><div class="sd-cover"><partial name="_CourseCover" model="item.Course"/></div><div class="sd-course-main"><span class="sd-state @(item.IsCompleted?"is-completed":"")">@(item.IsCompleted?"Đã hoàn thành":item.IsStarted?"Đang học":"Chưa bắt đầu")</span><h3>@item.Course.Title</h3><p class="sd-teacher">@item.Course.Instructor?.FullName</p><div class="sd-course-progress"><span>@item.CompletedLessons/@item.LessonCount bài hoàn thành</span><strong>@item.Percent%</strong><progress max="100" value="@item.Percent" aria-label="Tiến độ @item.Course.Title">@item.Percent%</progress></div>
@if(!item.IsCompleted&&item.ResumePositionSec>0){<p class="sd-save"><i data-lucide="bookmark-check" aria-hidden="true"></i>@item.ContinueLessonTitle · lưu tại @UiText.Duration(item.ResumePositionSec)</p>}else if(!item.IsCompleted&&item.ContinueLessonTitle!=null){<p class="sd-save"><i data-lucide="corner-down-right" aria-hidden="true"></i>@item.ContinueLessonTitle</p>}
<small class="sd-last">@(item.IsStarted?"Học gần nhất":"Đăng ký") @item.LastActivity.ToString("dd/MM/yyyy · HH:mm")</small></div><div class="sd-course-action">@if(item.LessonCount>0){<a class="button secondary" asp-controller="Learning" asp-action="Learn" asp-route-id="@item.Course.Id" asp-route-lessonId="@item.ContinueLessonId">@(item.IsCompleted?"Ôn tập":item.IsStarted?"Tiếp tục":"Vào học")<i data-lucide="arrow-right" aria-hidden="true"></i></a>}else{<span class="sd-last">Chưa có bài học</span>}</div></article>}</div>
<div class="sd-empty" data-study-empty hidden><i data-lucide="book-open" aria-hidden="true"></i><h3>Không có khóa học phù hợp</h3><p>Thử đổi bộ lọc hoặc từ khóa tìm kiếm.</p></div>
@if(Model.Items.Count==0){<div class="sd-empty"><i data-lucide="book-open" aria-hidden="true"></i><h3>Bạn chưa đăng ký khóa học nào</h3><p>Những khóa học bạn tham gia sẽ xuất hiện tại đây.</p><a asp-controller="Courses" asp-action="Index">Khám phá khóa học</a></div>}
</section><aside class="sd-sidebar"><section class="sd-card sd-journey"><h2>Hành trình của bạn</h2><div class="sd-ring" style="--sd-progress:@(overall)%" role="img" aria-label="Đã hoàn thành @overall phần trăm tổng số bài học"><div><strong>@overall%</strong><span>đã hoàn thành</span></div></div><p><strong>@Model.TotalCompletedLessons</strong> / @lessons bài học</p><small>Tiếp tục từng bài để hoàn thành khóa học.</small></section><section class="sd-card sd-guide"><span class="sd-stat-icon"><i data-lucide="cloud-check" aria-hidden="true"></i></span><h2>Tiến độ luôn đồng hành</h2><p>Vị trí video đang xem được lưu riêng với phần trăm hoàn thành khóa học.</p><ul><li>Video: xem đủ 80% để hoàn thành bài.</li><li>Bài viết: bấm Đánh dấu hoàn thành.</li><li>Quiz: đạt điểm yêu cầu để mở bài tiếp theo.</li></ul><p class="sd-guide-note">Phần trăm khóa học chỉ tăng khi một bài được hoàn thành.</p></section></aside></div>
</div>
