@model InstructorReportViewModel
@{ViewData["Title"]="Tổng quan giảng viên";var report=Model.Revenue;}
@section Styles {<link rel="stylesheet" href="~/css/reports.css" asp-append-version="true"/>}
<div class="page-heading"><div><span class="eyebrow">STUDIO GIẢNG VIÊN</span><h1>Tổng quan giảng viên</h1><p class="muted">Thu nhập theo kỳ và kết quả học tập trong các khóa của bạn.</p></div><a class="button" asp-controller="Finance" asp-action="Revenue">Chi tiết doanh thu</a></div>
<section class="rp-panel"><form method="get" class="rp-filter"><div><label for="from">Từ ngày tạo đơn</label><input id="from" name="from" type="date" value="@report.From.ToString("yyyy-MM-dd")" required/></div><div><label for="to">Đến ngày tạo đơn</label><input id="to" name="to" type="date" value="@report.To.ToString("yyyy-MM-dd")" required/></div><button class="button">Áp dụng</button><button name="export" value="true" class="button secondary">Xuất Excel</button></form><p class="muted">@(report.IsTest?"Chế độ mô phỏng, không chuyển tiền thật.":"Sổ giao dịch tiền thật.")</p>
<div class="rp-stats"><div><span>Giảng viên hưởng trong kỳ</span><strong>@UiText.Money(report.InstructorIncome)</strong><small>Sau chia doanh thu, trước thuế</small></div><div><span>Số dư có thể rút</span><strong>@UiText.Money(report.WithdrawableBalance)</strong><small>Toàn thời gian · trước thuế</small></div><div><span>Học viên ghi danh</span><strong>@Model.Students</strong><small>@Model.Enrollments lượt ghi danh · toàn thời gian</small></div><div><span>Hoàn thành trung bình</span><strong>@Model.AverageProgress.ToString("0.##")%</strong><small>Tính từ số bài hoàn thành thực tế</small></div></div></section>
<section class="rp-panel"><h2>Kết quả từng khóa học</h2><p class="muted">Số học viên và tiến độ là tổng hiện tại, không phụ thuộc bộ lọc doanh thu.</p><div class="rp-table" tabindex="0" role="region" aria-label="Kết quả khóa học"><table><thead><tr><th scope="col">Khóa học</th><th scope="col">Ghi danh</th><th scope="col">Đã hoàn thành</th><th scope="col">Tiến độ TB</th></tr></thead><tbody>@foreach(var course in Model.Courses){<tr><td>@course.Title</td><td>@course.Students</td><td>@course.Completed</td><td>@course.AverageProgress.ToString("0.##")%</td></tr>}</tbody></table></div>@if(Model.Courses.Count==0){<p>Chưa có khóa học để thống kê.</p>}</section>
